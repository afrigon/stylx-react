{
    "name": "stylx-react",
    "version": "0.1.0",
    "description": "Reusable React + TypeScript design-system primitives, the web port of stylx-swift.",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./preset.css": "./dist/preset.css"
    },
    "scripts": {
        "dev": "node scripts/generate-tokens.mjs && vite",
        "generate": "node scripts/generate-tokens.mjs",
        "build": "node scripts/generate-tokens.mjs && tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "prepare": "node scripts/generate-tokens.mjs && tsup"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.20.0",
            "onFail": "download"
        }
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19",
        "tailwindcss": ">=4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.1"
    }
}
